# Скопируй в .env и заполни значения: cp .env.example .env
# .env в git не попадает (см. .gitignore).

# --- PostgreSQL ---
POSTGRES_USER=jobhunter
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=jobhunter

# Хост/порт БД с точки зрения бэкенда.
# В docker compose это имя сервиса `db`. Для локального запуска без Docker — localhost.
DATABASE_HOST=db
DATABASE_PORT=5432

# --- Авторизация приложения (HTTP Basic) ---
# Логин/пароль браузерного диалога Basic Auth. Значения ниже — дефолты для локального
# запуска; смени их, если инстанс доступен кому-то ещё.
# Пустое значение любой из двух переменных = падение старта: так нельзя случайно
# поднять инстанс без авторизации (§6). Дефолтов в коде нет намеренно.
AUTH_USER=admin
AUTH_PASSWORD=admin

# --- Интеграция с hh.ru ---
# Данные вакансии берутся с публичной страницы hh.ru (§4.1), не из JSON API.
HH_SITE_BASE_URL=https://hh.ru
# hh.ru требует осмысленный User-Agent, иначе отвечает 400.
HH_USER_AGENT=job-hunter/1.0 (igor.ushakov@fastdev.se)
HH_REQUEST_TIMEOUT_MS=10000
HH_MAX_RETRIES=2
HH_SYNC_CONCURRENCY=3
HH_SYNC_MIN_DELAY_MS=200

# --- Порты и логи ---
# API_PORT — внутренний порт NestJS, на хост не публикуется.
API_PORT=3000
# WEB_PORT — порт приложения, публикуемый на хост (только на 127.0.0.1).
WEB_PORT=8080
LOG_LEVEL=log

# --- Тесты и локальная разработка ---
# Все три переменные опциональны: в коде есть дефолты, совпадающие с этими значениями.
# Порт, на котором Postgres из compose публикуется на 127.0.0.1 (нужен для e2e и TypeORM CLI).
DATABASE_PORT_HOST=5432
# Хост и имя БД для e2e-тестов. БД пересоздаётся при каждом прогоне, поэтому имя
# ОБЯЗАНО отличаться от POSTGRES_DB и заканчиваться на _test — иначе тесты не стартуют.
TEST_DATABASE_HOST=127.0.0.1
TEST_DATABASE_NAME=jobhunter_test
