# Скопируй в .env и заполни значения: cp .env.example .env
# .env в git не попадает (см. .gitignore).

# --- PostgreSQL ---
POSTGRES_USER=jobhunter
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=jobhunter

# Хост/порт БД с точки зрения бэкенда.
# В docker compose это имя сервиса `db`. Для локального запуска без Docker — localhost.
DATABASE_HOST=db
DATABASE_PORT=5432

# --- Авторизация приложения (HTTP Basic) ---
# Логин/пароль браузерного диалога Basic Auth. Значения ниже — дефолты для локального
# запуска; смени их, если инстанс доступен кому-то ещё.
# Пустое значение любой из двух переменных = падение старта: так нельзя случайно
# поднять инстанс без авторизации (§6). Дефолтов в коде нет намеренно.
AUTH_USER=admin
AUTH_PASSWORD=admin

# --- Интеграция с hh.ru ---
# Данные вакансии берутся с публичной страницы hh.ru (§4.1), не из JSON API.
HH_SITE_BASE_URL=https://hh.ru
# hh.ru требует осмысленный User-Agent, иначе отвечает 400.
HH_USER_AGENT=job-hunter/1.0 (igor.ushakov@fastdev.se)
HH_REQUEST_TIMEOUT_MS=10000
HH_MAX_RETRIES=2

# --- Интеграция с getmatch.ru (§4.9) ---
# Данные вакансии берутся из flight-payload Next.js страницы вакансии, не из JSON API
# (публичного API у getmatch.ru нет). В отличие от HH_USER_AGENT все четыре переменные
# опциональны — getmatch.ru не отвечает 403 на обычный User-Agent.
GETMATCH_SITE_BASE_URL=https://getmatch.ru
GETMATCH_USER_AGENT=job-hunter/1.0
GETMATCH_REQUEST_TIMEOUT_MS=10000
GETMATCH_MAX_RETRIES=2

# Общие для всех источников вакансий параметры массового прогона (§4.6):
# переименованы из HH_SYNC_CONCURRENCY/HH_SYNC_MIN_DELAY_MS.
SYNC_CONCURRENCY=3
SYNC_MIN_DELAY_MS=200

# --- Логотипы компаний (§4.10) ---
# Каталог на диске, куда скачиваются логотипы компаний при синхронизации. В Docker это
# точка монтирования именованного тома logos — файлы переживают пересоздание контейнера.
# Меняя путь, поменяй и точку монтирования тома в docker-compose.yml, иначе логотипы
# снова начнут пропадать при каждом релизе.
COMPANY_LOGO_DIR=/var/lib/job-hunter/logos
COMPANY_LOGO_REQUEST_TIMEOUT_MS=5000

# --- Плановая синхронизация (§4.7) ---
# Приложение само запускает прогон по всем открытым записям — тот же, что кнопка
# «Обновить все открытые». Первый прогон — не при старте, а через интервал.
# Допустимы только значения true/false.
SCHEDULED_SYNC_ENABLED=true
# 1800000 мс = 30 минут. Допустимый диапазон — от 60000 (1 мин) до 86400000 (24 ч).
SCHEDULED_SYNC_INTERVAL_MS=1800000

# --- Поиск, отбор и отображение вакансий с hh.ru (§4.11, §4.12) ---
# Общий троттл ВСЕХ запросов к hh.ru (страница вакансии при синхронизации/preview,
# страница выдачи и вакансии при поиске, логотипы с hhcdn.ru), не только поиска.
# Допустимый диапазон — от 0.1 до 50, обе границы проверяются при старте: значение
# выше 50 — это уже не троттл, а его отсутствие, и попасть туда опечаткой нельзя.
HH_MAX_REQUESTS_PER_SECOND=2
# Шаблон ссылки на выдачу hh.ru больше не задаётся здесь: это настройка
# vacancy_search_settings.search_url_template (§3.6), редактируется в диалоге
# «Настройки поиска» (§7.9.4) и валидируется при сохранении (https + хост hh.ru,
# плейсхолдер {page}; поисковый запрос — часть самой ссылки).
# Бюджеты одного прогона поиска (§4.11.8).
VACANCY_SCAN_MAX_PAGES=40
VACANCY_SCAN_MAX_DETAILS=600
VACANCY_SCAN_MAX_AGE_DAYS=30
VACANCY_SCAN_MAX_DURATION_MS=14400000
# exclude_only (дефолт) — только стоп-слова до ИИ; full — ещё и ключевые слова
# (дешёвый режим без ИИ); off — детерминированный отбор выключен целиком (§4.11.4).
VACANCY_PREFILTER_MODE=exclude_only
# any/all — режим отбора по ключевым словам, когда ИИ выключен или недоступен.
VACANCY_MATCH_MODE=any
# Потолок числа записей в ответе GET /api/vacancy-leads — предохранитель, не пагинация.
VACANCY_LEADS_LIST_LIMIT=500

# --- ИИ-отбор вакансий: локальная модель в Ollama (§4.12) ---
# ollama (дефолт, локальный контейнер без ключей) либо openai (облачный совместимый API).
VACANCY_AI_PROVIDER=ollama
VACANCY_AI_BASE_URL=http://ollama:11434
VACANCY_AI_MODEL=qwen3:4b-instruct
# Обязателен только при VACANCY_AI_PROVIDER=openai; для ollama не нужен вовсе.
VACANCY_AI_API_KEY=
VACANCY_AI_BATCH_SIZE=10
VACANCY_AI_TIMEOUT_MS=120000
VACANCY_AI_DESCRIPTION_MAX_CHARS=6000
# Порт, на котором ollama публикуется на 127.0.0.1. Нужен дев-режиму: `npm run dev:api`
# работает на хосте и имя `ollama` из compose-сети не резолвит — там base url должен
# быть http://127.0.0.1:11434. Само приложение эту переменную не читает.
OLLAMA_PORT_HOST=11434

# --- Порты и логи ---
# API_PORT — внутренний порт NestJS, на хост не публикуется.
API_PORT=3000
# WEB_PORT — порт приложения, публикуемый на хост (только на 127.0.0.1).
WEB_PORT=8080
LOG_LEVEL=log

# --- Тесты и локальная разработка ---
# Все три переменные опциональны: в коде есть дефолты, совпадающие с этими значениями.
# Порт, на котором Postgres из compose публикуется на 127.0.0.1 (нужен для e2e и TypeORM CLI).
DATABASE_PORT_HOST=5432
# Хост и имя БД для e2e-тестов. БД пересоздаётся при каждом прогоне, поэтому имя
# ОБЯЗАНО отличаться от POSTGRES_DB и заканчиваться на _test — иначе тесты не стартуют.
TEST_DATABASE_HOST=127.0.0.1
TEST_DATABASE_NAME=jobhunter_test
