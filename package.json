{
  "name": "job-hunter",
  "version": "1.0.0",
  "author": {
    "email": "i.am@igor-ushakov.ru",
    "name": "Igor Ushakov",
    "url": "https://t.me/hino_2"
  },
  "private": true,
  "description": "Personal job application tracker with hh.ru status sync",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=backend",
    "dev:web": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,yml,yaml,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,yml,yaml,html}\"",
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "ps": "docker compose ps"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0"
  }
}
